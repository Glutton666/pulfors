{
  "expo": {
    "name": "PulFors",
    "slug": "pulfors",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "pulfors",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pulfors.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "마이크를 사용하여 악기 음정을 감지하고 튜닝합니다."
      }
    },

    "android": {
      "package": "com.pulfors.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D1117",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },

    "web": {
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "마이크를 사용하여 악기 음정을 감지하고 튜닝합니다."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "eas": {
        "projectId": "ba0bcd08-da0d-4317-a8e2-e72ed4bb3411"
      }
    },

    "updates": {
      "url": "https://u.expo.dev/ba0bcd08-da0d-4317-a8e2-e72ed4bb3411"
    }
  }
}
