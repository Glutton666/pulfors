{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "20.19.4",
      "developmentClient": true,
      "distribution": "internal",
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" }
    },
    "preview": {
      "node": "20.19.4",
      "distribution": "internal",
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" }
    },
    "production": {
      "node": "20.19.4",
      "autoIncrement": true,
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" }
    },
    "production-apk": {
      "node": "20.19.4",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" }
    }
  },
  "submit": {
    "production": {}
  }
}
