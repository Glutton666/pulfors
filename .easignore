# EAS Build upload ignore rules.
#
# IMPORTANT: when this file exists, EAS Build uses it INSTEAD OF .gitignore
# to decide what to upload — the two are not merged. This file mirrors
# .gitignore but deliberately does NOT exclude models/*.ort — those files
# are excluded from *git* (GitHub's 100MB per-file limit) but MUST be
# included in the EAS build upload, since lib/stem-separation.ts require()s
# them directly for bundling. Keep this file in sync with .gitignore
# whenever .gitignore changes, except for that one exclusion.

# dependencies (EAS runs its own install)
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/
# Exception: audio-decoder is a hand-written local Expo module (not expo-prebuild
# output) — its ios/ and android/ source folders must be uploaded.
!modules/audio-decoder/ios/
!modules/audio-decoder/ios/**
!modules/audio-decoder/android/
!modules/audio-decoder/android/**
# sparse-metronome도 손으로 작성한 로컬 Expo 모듈이다(.gitignore와 동일 예외).
# 이 예외가 없으면 android/ 소스가 EAS 업로드에서 빠져 네이티브 모듈이 빌드에 안 들어간다.
!modules/sparse-metronome/android/
!modules/sparse-metronome/android/**
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env

# Playwright E2E
test-results/
playwright-report/
.cache/ms-playwright/

# .gitignore와 동기화 (.easignore가 있으면 .gitignore는 업로드에 쓰이지 않는다).
# package-lock.json: 로컬에 남은 npm lockfile이 업로드되면 EAS 서버의
# yarn install / expo doctor에서 "multiple lock files" 경고가 난다.
package-lock.json
static-build/
/generated-artifacts/
# 개발용 참고 자료(녹음/스크린샷, 약 50MB). 앱 코드는 참조하지 않으므로 업로드 제외.
attached_assets/
