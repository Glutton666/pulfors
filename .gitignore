# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Stem-separation AI models — too large for a normal git push (GitHub's 100MB
# per-file limit). Bundled locally/on-device via require() in
# lib/stem-separation.ts; must be placed in this folder manually on every
# machine that builds the app (not synced through git).
models/*.ort
models/*.onnx

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/
# Exception: audio-decoder is a hand-written local Expo module (not expo-prebuild
# output) — its ios/ and android/ source folders must stay under version control.
!modules/audio-decoder/ios/
!modules/audio-decoder/ios/**
!modules/audio-decoder/android/
!modules/audio-decoder/android/**
!modules/sparse-metronome/android/
!modules/sparse-metronome/android/**
# note-tts도 손으로 작성한 로컬 Expo 모듈이다. 네이티브 소스를 git에 포함한다.
!modules/note-tts/android/
!modules/note-tts/android/**
!modules/note-tts/ios/
!modules/note-tts/ios/**
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# npm is the root application's install contract; commit package-lock.json.
!/package-lock.json
# Preserve the separate sandbox's previously ignored generated lockfile.
/artifacts/mockup-sandbox/package-lock.json

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env

# Playwright E2E
test-results/
playwright-report/
.cache/ms-playwright/
static-build/
/generated-artifacts/
